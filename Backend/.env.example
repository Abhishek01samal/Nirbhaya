NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string
MONGODB_URI=

# Owned by Person 3 (auth)
JWT_SECRET=nirbhaya
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173
SOCKET_CORS_ORIGIN=http://localhost:5173

# LiveKit (server-side only; never expose LIVEKIT_API_SECRET to clients)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=600

# Monitoring thresholds
LOCATION_TTL_DAYS=7
OFF_ROUTE_THRESHOLD_M=150
OFF_ROUTE_DEBOUNCE_POINTS=3
OFF_ROUTE_COOLDOWN_S=120
STOP_RADIUS_M=50
STOP_SECONDS=300
GUARDIAN_ESCALATION_TIMEOUT_SECONDS=60
RESPONDER_ESCALATION_TIMEOUT_SECONDS=60

# Google Maps
GOOGLE_MAPS_API_KEY=

# AI providers
GROQ_API_KEY=
GEMINI_API_KEY=
JINA_API_KEY=
TAVILY_API_KEY=
TRANSLATE_ENABLED=true

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
